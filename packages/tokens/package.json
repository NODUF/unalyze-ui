{
  "name": "@noduf/unalyze-tokens",
  "version": "0.1.0",
  "description": "Unalyze design tokens \u2014 generated from Figma Variables, emitted as CSS custom properties and JS values.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NODUF/unalyze-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/NODUF/unalyze-ui#readme",
  "bugs": {
    "url": "https://github.com/NODUF/unalyze-ui/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "generated"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./generated/tokens.css",
    "./contract": "./generated/tokens.contract.json",
    "./dtcg": "./generated/tokens.dtcg.json"
  },
  "scripts": {
    "build": "tsx scripts/figma-to-ts.ts && tsx scripts/emit.ts && tsup",
    "generate": "tsx scripts/figma-to-ts.ts && tsx scripts/emit.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
